{"dt3el-l01":{"who":"Lisa","text":"Hi! I'm Lisa. This is Ask Lisa: Donee Talk.","dur":4.62,"segs":[[0.08,1.49,0,14],[1.87,4.5,14,43]],"env":"000124999997569986544444321110000000019997522234433455310000005997654321110000000000000000001222299997982000000000045554311000000079999999521001001245555544310000368753221110000000000123225999987543333442111237863222220000110000000"},"dt3el-l02":{"who":"Lisa","text":"It helps you ask someone to be your donee. Come, I'll show you!","dur":4.19,"segs":[[0.08,2.47,0,43],[2.82,4.07,43,63]],"env":"000355312222223565400000014798643210454444541101101110002454322222333333211365221123333222467764100478754433332233332111111000000000000000004459999997422333332102200099999965442289998997334556654333222110000000"},"dt3el-l03":{"who":"Lisa","text":"Say I want to ask Mei Ling to be my donee.","dur":3.01,"segs":[[0.08,2.89,0,42]],"env":"003897655433333455400343334321233233321011354004543333321000011112223444443333445555456554443322222210113431023333322333333210026776554322111111111110"},"dt3el-l04":{"who":"Lisa","text":"Mei Ling, will you be my donee?","dur":2.52,"segs":[[0.08,0.81,0,10],[1.23,2.4,10,31]],"env":"000122222234555444444455554332222111221110000000000000000001111234444321234565201685431233333331101455433444323322222111100000"},"dt3el-l05":{"who":"Lisa","text":"Asking isn't easy. She has worries, and I don't know what to say.","dur":5.47,"segs":[[0.08,0.32,0,0],[0.86,2.29,0,19],[2.67,5.35,19,65]],"env":"001122333222111111111100000000000000010001222233211101101243222222235542013433210000112222333444210123322212222210000000000000000000122223332222354211123322234444444434443322223332100000000123211211100000022222222111122111233222344201114531110000013322222333222111111000000"},"dt3el-l06":{"who":"Lisa","text":"Ask Lisa works on my phone too.","dur":2.27,"segs":[[0.08,2.15,0,31]],"env":"00199999996210110014665445687310001799986666558999940111069995224998652000299965433354122278568864554432210000000"},"dt3el-l07":{"who":"Lisa","text":"Let me give you a demonstration!","dur":1.68,"segs":[[0.08,1.56,0,32]],"env":"000269999991247864322999938999999998315999965555541111138978995234433797532111111110"},"dt3el-l08":{"who":"Lisa","text":"I've been thinking about what would happen if I cannot make decisions","dur":3.74,"segs":[[0.08,3.62,0,69]],"env":"0002454443210000177322110000157754431113444445653203554444432111244432103553122223322344432000234332222211221000123321000111111123443344332111233432100013331100012333223222221111111110000"},"dt3el-l09":{"who":"Lisa","text":"If you're concerned about making the wrong decision, don't worry - we can discuss my wishes and values now, and let them guide you should you need to make a decision","dur":8.96,"segs":[[0.08,3.61,0,67],[3.91,8.84,67,165]],"env":""},"dt3el-l10":{"who":"Lisa","text":"I am asking because I trust you. I believe you will decide what's best for me.","dur":4.8,"segs":[[0.08,2.21,0,33],[2.56,4.68,33,78]],"env":"000344444333322212200244334443111010011233322222221244201112333102202332210012221111244421111111011122211111111000000000000000056677751037876666644544555542102334543244542113432100002332223321001342000011000575321111111100022211111111111110"},"dt3el-l11":{"who":"Lisa","text":"Asking is easier when you know what to say and how to say it. Try Ask Lisa, on your computer or your phone!","dur":7.02,"segs":[[0.08,3.55,0,62],[3.87,6.9,62,107]],"env":""},"dt3el-m01":{"who":"Mei Ling","text":"Will I have to pay for you? / What if I decide wrong? / But you're still healthy! / Can I really cope?","dur":7,"segs":[[0.08,1.61,0,30],[2.12,3.53,30,56],[3.9,5.09,56,84],[5.46,6.88,84,102]],"env":""},"dt3el-m02":{"who":"Mei Ling","text":"What if I make the wrong decision for you?","dur":2.31,"segs":[[0.08,2.19,0,42]],"env":"00011111357654467522389987789999621003686544459999999999346754543344577766766789974211113444332232222111111110000000"},"dt3el-m03":{"who":"Mei Ling","text":"Okay… but why me?","dur":2.29,"segs":[[0.08,0.74,0,6],[1.02,2.17,6,17]],"env":"0001